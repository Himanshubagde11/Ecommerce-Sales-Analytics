# Environments
.venv/
venv/
env/
ENV/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/

# Large Datasets (>25MB / GitHub 100MB limit)
# Note: Full datasets are generated programmatically via python/run_pipeline.py
data/raw/*.csv
data/processed/*.csv
!data/sample/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs & temporary files
*.log
pipeline.log
*.tmp

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE configurations
.vscode/
.idea/
*.suo
*.user

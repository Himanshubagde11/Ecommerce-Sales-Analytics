        "partitions": [
          {
            "name": "_Measures Partition",
            "state": "calculationNeeded",
            "modifiedTime": "2026-09-11T12:20:17.293333",
            "refreshedTime": "1699-12-31T00:00:00",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Description\", \"Veyra E-Commerce KPI Measures Container\")"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "VAR Result = SUM('dw FactSales'[SalesAmount]) RETURN COALESCE(Result, 0)",
            "formatString": "\\$#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Profit",
            "expression": "VAR Result = SUM('dw FactSales'[ProfitAmount]) RETURN COALESCE(Result, 0)",
            "formatString": "\\$#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Cost",
            "expression": "VAR Result = SUM('dw FactSales'[CostAmount]) RETURN COALESCE(Result, 0)",
            "formatString": "\\$#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Profit Margin",
            "expression": "VAR Revenue = [Total Revenue] VAR Profit = [Total Profit] VAR Result = DIVIDE(Profit, Revenue, 0) RETURN Result",
            "formatString": "0.0%",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Orders",
            "expression": "VAR Result = DISTINCTCOUNT('dw FactSales'[OrderID]) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Quantity",
            "expression": "VAR Result = SUM('dw FactSales'[Quantity]) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Average Order Value",
            "expression": "VAR Revenue = [Total Revenue] VAR Orders = [Total Orders] VAR Result = DIVIDE(Revenue, Orders, 0) RETURN Result",
            "formatString": "\\$#,0.00",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Discounts",
            "expression": "VAR Result = SUM('dw FactSales'[DiscountAmount]) RETURN COALESCE(Result, 0)",
            "formatString": "\\$#,0",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Discount Rate %",
            "expression": "VAR TotalDisc = [Total Discounts] VAR GrossRev = [Total Revenue] + TotalDisc VAR Result = DIVIDE(TotalDisc, GrossRev, 0) RETURN Result",
            "formatString": "0.0%",
            "displayFolder": "1. Financial & Sales",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Prior Month Revenue",
            "expression": "VAR Result = CALCULATE([Total Revenue], DATEADD('dw DimDate'[FullDate], -1, MONTH)) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "MoM Revenue %",
            "expression": "VAR CurrentRevenue = [Total Revenue] VAR PriorRevenue = [Prior Month Revenue] VAR Result = DIVIDE(CurrentRevenue - PriorRevenue, PriorRevenue, 0) RETURN Result",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Prior Year Revenue",
            "expression": "VAR Result = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('dw DimDate'[FullDate])) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "YoY Revenue %",
            "expression": "VAR CurrentRevenue = [Total Revenue] VAR PriorRevenue = [Prior Year Revenue] VAR Result = DIVIDE(CurrentRevenue - PriorRevenue, PriorRevenue, 0) RETURN Result",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "YTD Revenue",
            "expression": "VAR Result = TOTALYTD([Total Revenue], 'dw DimDate'[FullDate]) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "YTD Profit",
            "expression": "VAR Result = TOTALYTD([Total Profit], 'dw DimDate'[FullDate]) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Rolling 3M Revenue",
            "expression": "VAR Result = CALCULATE([Total Revenue], DATESINPERIOD('dw DimDate'[FullDate], MAX('dw DimDate'[FullDate]), -3, MONTH)) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Rolling 12M Revenue",
            "expression": "VAR Result = CALCULATE([Total Revenue], DATESINPERIOD('dw DimDate'[FullDate], MAX('dw DimDate'[FullDate]), -12, MONTH)) RETURN Result",
            "formatString": "\\$#,0",
            "displayFolder": "2. Time Intelligence",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Customers",
            "expression": "VAR Result = DISTINCTCOUNT('dw DimCustomer'[CustomerKey]) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "3. Customer & Retention",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Active Purchasing Customers",
            "expression": "VAR Result = CALCULATE(DISTINCTCOUNT('dw FactSales'[CustomerKey]), 'dw FactSales'[SalesAmount] > 0) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "3. Customer & Retention",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Repeat Customers",
            "expression": "VAR Result = COUNTROWS(FILTER(VALUES('dw DimCustomer'[CustomerKey]), CALCULATE(DISTINCTCOUNT('dw FactSales'[OrderID])) > 1)) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "3. Customer & Retention",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "One-Time Buyers",
            "expression": "VAR Result = COUNTROWS(FILTER(VALUES('dw DimCustomer'[CustomerKey]), CALCULATE(DISTINCTCOUNT('dw FactSales'[OrderID])) = 1)) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "3. Customer & Retention",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Repeat Customer Rate",
            "expression": "VAR RepeatCust = [Repeat Customers] VAR TotalActive = [Active Purchasing Customers] VAR Result = DIVIDE(RepeatCust, TotalActive, 0) RETURN Result",
            "formatString": "0.0%",
            "displayFolder": "3. Customer & Retention",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Average Revenue Per Customer",
            "expression": "VAR Revenue = [Total Revenue] VAR Customers = [Active Purchasing Customers] VAR Result = DIVIDE(Revenue, Customers, 0) RETURN Result",
            "formatString": "\\$#,0.00",
            "displayFolder": "3. Customer & Retention",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Estimated CLV",
            "expression": "VAR AvgAOV = [Average Order Value] VAR CustOrders = [Total Orders] VAR MarginRate = [Profit Margin] VAR ActiveCust = [Active Purchasing Customers] VAR AnnualOrdersPerCust = DIVIDE(CustOrders, ActiveCust * 4, 0) VAR FutureHorizonMultiplier = 2.125 VAR ProjectedMargin = AnnualOrdersPerCust * AvgAOV * MarginRate * FutureHorizonMultiplier VAR HistoricalProfitPerCust = DIVIDE([Total Profit], ActiveCust, 0) RETURN HistoricalProfitPerCust + ProjectedMargin",
            "formatString": "\\$#,0.00",
            "displayFolder": "3. Customer & Retention",
            "dataType": "double",
            "modifiedTime": "2026-09-11T12:21:00.616667",
            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Active Catalog Products",
            "expression": "VAR Result = DISTINCTCOUNT('dw DimProduct'[ProductKey]) RETURN COALESCE(Result, 0)",
            "formatString": "#,0",
            "displayFolder": "4. Products & Merchandising",
            "dataType": "int64",
            "modifiedTime": "2026-09-11T12:21:00.616667",

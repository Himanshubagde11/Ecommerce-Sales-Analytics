            "structureModifiedTime": "2026-09-11T12:21:00.5"
          },
          {
            "name": "Total Return Incidents",
            "expression": "VAR Result = DISTINCTCOUNT('dw FactReturns'[ReturnID]) RETURN COALESCE(Result, 0)",

          },
          {
            "name": "Average Selling Price",
            "expression": "VAR Result = DIVIDE([Total Revenue], [Total Quantity], 0) RETURN Result",
            "formatString": "\\$#,0.00",
            "displayFolder": "4. Products & Merchandising",
            "dataType": "double",
